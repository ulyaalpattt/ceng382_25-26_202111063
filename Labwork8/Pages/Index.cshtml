@page
@model Labwork5.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class Information</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        /* Custom CSS to position the logout button in the top-right corner */
        .logout-button {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 999;
        }

        /* Export buttons just above the table */
        .export-buttons {
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
        }

        .export-buttons button {
            min-width: 150px;
        }
    </style>
</head>
<body>
    <div class="container">
        @if (HttpContext.Session.GetString("username") != null)
        {
            <!-- Logout Button in the top-right corner -->
            <form method="post" asp-page-handler="Logout" class="logout-button">
                <button type="submit" class="btn btn-danger">Logout</button>
            </form>
        }

        <h1 class="mt-4 mb-4">Class Information</h1>

        <!-- Çerez Bilgileri -->
        <div class="mt-4">
            <h5>Cookie Information</h5>
            <p><strong>Username:</strong> @Model.cookieUsername</p>
            <p><strong>Token:</strong> @Model.cookieToken</p>
            <p><strong>Session ID:</strong> @Model.cookieSessionId</p>
        </div>

        <div class="row">
            <!-- Sol Kısım: Filtreleme ve Form -->
            <div class="col-md-6">
                <!-- Filtreleme Formu -->
                <form method="get" class="mb-4">
                    <div class="form-group">
                        <label for="SearchTerm">Filter by Class Name</label>
                        <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" />
                    </div>

                    <!-- Öğrenci Sayısı Filtreleri -->
                    <div class="form-group">
                        <label for="MinStudentCount">Minimum Student Count</label>
                        <input type="number" class="form-control" name="MinStudentCount" value="@Model.MinStudentCount" />
                    </div>
                    <div class="form-group">
                        <label for="MaxStudentCount">Maximum Student Count</label>
                        <input type="number" class="form-control" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                    </div>

                    <!-- Açıklama Filtreleme -->
                    <div class="form-group">
                        <label for="DescriptionFilter">Filter by Description</label>
                        <input type="text" class="form-control" name="DescriptionFilter" value="@Model.DescriptionFilter" />
                    </div>

                    <button type="submit" class="btn btn-primary mt-2">Filter</button>
                </form>

                <!-- Ekleme/Güncelleme Formu -->
                <form method="post">
                    <input type="hidden" asp-for="ClassIdToEdit" />

                    <div class="form-group">
                        <label for="ClassName">Class Name</label>
                        <input type="text" class="form-control" asp-for="ClassName" required />
                    </div>
                    <div class="form-group">
                        <label for="StudentCount">Student Count</label>
                        <input type="number" class="form-control" asp-for="StudentCount" required />
                    </div>
                    <div class="form-group">
                        <label for="Description">Description</label>
                        <textarea class="form-control" asp-for="Description" required></textarea>
                    </div>

                    @if (Model.ClassIdToEdit != null)
                    {
                        <button type="submit" asp-page-handler="Update" class="btn btn-success mt-2">Update Class</button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Add" class="btn btn-primary mt-2">Add Class</button>
                    }
                </form>
            </div>

            <!-- Sağ Kısım: Tablo -->
            <div class="col-md-6">
                <!-- Export Butonları -->
                <div class="export-buttons">
                    <form method="post">
                        <input type="hidden" asp-for="SelectedColumnsJson" id="selectedColumnsInput" />
                        <button asp-page-handler="ExportJson" name="mode" value="all" class="btn btn-secondary">Export All to JSON</button>
                        <button asp-page-handler="ExportJson" name="mode" value="filtered" class="btn btn-secondary">Export Filtered to JSON</button>
                    </form>
                </div>

                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th class="selectable-column" data-column="ClassName">Class Name</th>
                            <th class="selectable-column" data-column="StudentCount">Student Count</th>
                            <th class="selectable-column" data-column="Description">Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredClasses)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    </form>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Sayfalama -->
                @if (Model.TotalPages > 0)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mt-4">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-CurrentPage="@i"
                                       asp-route-SearchTerm="@Model.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                                   asp-route-SearchTerm="@Model.SearchTerm">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>

        <!-- JSON çıktısını göstermek için alan -->
        @if (TempData["JsonPreview"] != null)
        {
            <div class="mt-4">
                <h5>Exported JSON Preview:</h5>
                <pre style="max-height: 300px; overflow-y: auto; background-color: #f8f9fa; padding: 10px; border: 1px solid #ddd;">
                    @ViewData["JsonPreview"]
                </pre>
            </div>
        }
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selectedColumns = new Set();
            const selectedInput = document.getElementById("selectedColumnsInput");

            document.querySelectorAll('.selectable-column').forEach(th => {
                th.addEventListener('click', () => {
                    const column = th.getAttribute('data-column');
                    if (selectedColumns.has(column)) {
                        selectedColumns.delete(column);
                        th.style.backgroundColor = '';
                    } else {
                        selectedColumns.add(column);
                        th.style.backgroundColor = '#d1e7dd';
                    }

                    selectedInput.value = JSON.stringify(Array.from(selectedColumns));
                    console.log("Selected Columns:", selectedInput.value);
                });
            });
        });
    </script>
</body>
</html>
