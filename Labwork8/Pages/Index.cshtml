@page
@model Labwork5.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class Information</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            margin-bottom: 50px;
            /* Sayfa altına ekstra boşluk bırak */
        }

        form {
            margin-bottom: 20px;
            /* Form altındaki boşluğu artır */
        }

        .logout-button {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 999;
        }

        .export-buttons {
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
        }

        .export-buttons button {
            min-width: 150px;
        }
    </style>
</head>

<body>
    <div class="container">
        @if (HttpContext.Session.GetString("username") != null)
        {
            <!-- Logout Button in the top-right corner -->
            <form method="post" asp-page-handler="Logout" class="logout-button">
                <button type="submit" class="btn btn-danger">Logout</button>
            </form>
        }

        <h1 class="mt-4 mb-4">Class Information</h1>

        <div class="row">
            <!-- Left Section: Filter and Form -->
            <div class="col-md-6">
                <!-- Filter Form -->
                <form method="get" class="mb-4">
                    <div class="form-group">
                        <label for="SearchTerm">Filter by Class Name</label>
                        <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" />
                    </div>

                    <!-- Student Count Filters -->
                    <div class="form-group">
                        <label for="MinStudentCount">Minimum Student Count</label>
                        <input type="number" class="form-control" name="MinStudentCount" value="@Model.MinStudentCount" />
                    </div>
                    <div class="form-group">
                        <label for="MaxStudentCount">Maximum Student Count</label>
                        <input type="number" class="form-control" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                    </div>

                    <!-- Description Filter -->
                    <div class="form-group">
                        <label for="DescriptionFilter">Filter by Description</label>
                        <input type="text" class="form-control" name="DescriptionFilter" value="@Model.DescriptionFilter" />
                    </div>

                    <button type="submit" class="btn btn-primary mt-2">Filter</button>
                </form>

                <!-- Add/Update Form -->
                <form method="post">
                    <input type="hidden" asp-for="ClassIdToEdit" value="@Model.ClassIdToEdit" />

                    <div class="form-group">
                        <label for="ClassName">Class Name</label>
                        <input type="text" class="form-control" asp-for="ClassName" required />
                    </div>
                    <div class="form-group">
                        <label for="StudentCount">Student Count</label>
                        <input type="number" class="form-control" asp-for="StudentCount" required />
                    </div>
                    <div class="form-group">
                        <label for="Description">Description</label>
                        <textarea class="form-control" asp-for="Description" required></textarea>
                    </div>

                    @if (Model.ClassIdToEdit != null)
                    {
                        <button type="submit" asp-page-handler="Update" class="btn btn-success mt-2">Update Class</button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Add" class="btn btn-primary mt-2">Add Class</button>
                    }
                </form>
            </div>

            <!-- Right Section: Table -->
            <div class="col-md-6">
                <h4 class="mt-4">Classes</h4>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Person Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredClasses)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    </form>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Export Section -->
        <div class="export-buttons">
            <form method="post" asp-page-handler="ExportJson" asp-route-mode="filtered">
                <button type="submit" class="btn btn-secondary">Export Filtered Data</button>
            </form>
            <form method="post" asp-page-handler="ExportJson" asp-route-mode="all">
                <button type="submit" class="btn btn-secondary">Export All Data</button>
            </form>
        </div>

    </div>
</body>

</html>
